{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { 
      "src": "/api/(.*)", 
      "dest": "https://erp-crm-backend-4snq50gfo-eimctaisodoc-bits-projects.vercel.app/$1" 
    },
    { "src": "/(.*)", "dest": "/" }
  ]
}
